{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Token Pass Swith",
  "version": "3.16.5",
  "identifier": "com.tokenpass.swith.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm run dev:renderer",
    "beforeBuildCommand": "pnpm run build:renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "",
        "titleBarStyle": "Overlay",
        "width": 1000,
        "height": 650,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: http:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https: http:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "Token Pass Swith",
    "homepage": "https://tokenpass.cloud",
    "copyright": "Copyright (c) 2026 Token Pass Swith Contributors",
    "license": "MIT",
    "licenseFile": "wix/LICENSE.rtf",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "template": "wix/per-user-main.wxs"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["tokenpassswith"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlDQkE0OTNDQzlERkE3NwpSV1IzK3AzTWs2VExDUjQ2YlM0NHhUU0RXVjJFTnE1WkJzSkxsU0Uvak9veHNFZTgwdmYrY0VRVwo=",
      "endpoints": [
        "https://tokenpass.cloud/downloads/token-pass-swith/latest.json"
      ]
    }
  }
}
